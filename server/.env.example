# Owner connection: migrations, seed and the platform Console (bypasses row-level security).
DATABASE_URL="postgresql://deepdev:deepdev@localhost:5433/deepdev"
# App connection: every school request (row-level security applies).
APP_DATABASE_URL="postgresql://app_user:app_user@localhost:5433/deepdev"
PORT=4000
# Where the Next.js app runs (for better-auth trusted origins and links in emails).
WEB_ORIGIN="http://localhost:3000"
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6380"
# Google Cloud Storage through its S3-compatible API (MinIO locally).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="deepdev-files"
S3_ACCESS_KEY="deepdev"
S3_SECRET_KEY="deepdev-secret"
