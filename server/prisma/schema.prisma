// DeepDev ERP database. Shapes follow client/src/types; see ../BACKEND-PLAN.md.
// Every school-owned table carries tenant_id and is protected by row-level security
// (prisma/migrations/*_rls). The platform and auth tables are managed by the auth layer.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  trial
  suspended
}

/// Mirrors ModuleKey in client/src/types/tenant.ts.
enum ModuleKey {
  students
  fees
  attendance
  staff
  payroll
  exams
  paper_maker
  messages
  reports
}

enum MemberStatus {
  active
  invited
  disabled
}

// ---------------------------------------------------------------------------
// Auth (better-auth core + organization + admin plugins)
// ---------------------------------------------------------------------------

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  /// Platform role from the admin plugin: "admin" is a DeepDev platform admin (super_admin in the app).
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?      @map("ban_reason")
  banExpires    DateTime?    @map("ban_expires")
  /// Mobile number (owner contact in the Console, staff contact).
  phone         String?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  activeOrganizationId String?  @map("active_organization_id")
  impersonatedBy       String?  @map("impersonated_by")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// A school (tenant). better-auth's organization, plus the plan fields the Console manages.
model Organization {
  id           String         @id
  name         String
  slug         String         @unique
  logo         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  metadata     String?
  city         String         @default("")
  status       TenantStatus   @default(trial)
  modules      ModuleKey[]
  /// Most active students allowed; 0 when the Students module is off.
  studentSeats Int            @default(0) @map("student_seats")
  members      Member[]
  invitations  Invitation[]
  events       TenantEvent[]
  branches     Branch[]
  sessions     AcademicSession[]

  @@map("organization")
}

/// A person's place in a school: their school role, campuses and staff record.
model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  /// owner | branch_admin | accountant | front_desk | teacher (client/src/types/user.ts)
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  /// Campuses this person works in; empty means every campus.
  branchIds      String[]     @map("branch_ids")
  staffId        String?      @map("staff_id")
  title          String       @default("")
  status         MemberStatus @default(active)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ---------------------------------------------------------------------------
// School setup (row-level security on tenant_id)
// ---------------------------------------------------------------------------

model TenantEvent {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  at           DateTime     @default(now())
  by           String
  text         String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_event")
}

model Branch {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  name         String
  code         String
  location     String
  organization Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes      SchoolClass[]

  @@unique([tenantId, code])
  @@map("branch")
}

model AcademicSession {
  id           String       @id @default(cuid())
  tenantId     String       @map("tenant_id")
  label        String
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  current      Boolean      @default(false)
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@map("academic_session")
}

/// Institute profile (Settings → Institute); one per school.
model CampusProfile {
  tenantId           String  @id @map("tenant_id")
  schoolName         String  @map("school_name")
  tagline            String  @default("")
  registrationNumber String  @default("") @map("registration_number")
  contactEmail       String  @default("") @map("contact_email")
  contactPhone       String  @default("") @map("contact_phone")
  website            String  @default("")
  streetAddress      String  @default("") @map("street_address")
  city               String  @default("")
  province           String  @default("")
  postalCode         String  @default("") @map("postal_code")
  country            String  @default("Pakistan")
  logoUrl            String? @map("logo_url")
  principalName      String  @default("") @map("principal_name")

  @@map("campus_profile")
}

/// School rules (Settings → School rules); shapes match SchoolRules in client/src/types/settings.ts.
model SchoolRules {
  tenantId      String @id @map("tenant_id")
  attendance    Json
  fees          Json
  grading       Json
  notifications Json

  @@map("school_rules")
}

/// The role × permission matrix (Settings → Roles), as RolePermissionsState.
model TenantPermissions {
  tenantId String @id @map("tenant_id")
  matrix   Json

  @@map("tenant_permissions")
}

/// Per-school running numbers (STD-1042, STF-201, voucher and receipt numbers).
model Counter {
  tenantId String @map("tenant_id")
  key      String
  value    Int

  @@id([tenantId, key])
  @@map("counter")
}

// ---------------------------------------------------------------------------
// Academics and students (row-level security on tenant_id)
// ---------------------------------------------------------------------------

model SchoolClass {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  branchId      String         @map("branch_id")
  name          String
  order         Int
  stage         String?
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sections      Section[]
  classSubjects ClassSubject[]

  @@unique([branchId, name])
  @@map("school_class")
}

model Section {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  classId    String      @map("class_id")
  name       String
  shift      String
  capacity   Int
  inchargeId String?     @map("incharge_id")
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@map("section")
}

model Subject {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  name          String
  code          String
  classSubjects ClassSubject[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@map("subject")
}

model ClassSubject {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  classId   String      @map("class_id")
  subjectId String      @map("subject_id")
  elective  Boolean
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subject")
}

model Student {
  id                 String            @id
  tenantId           String            @map("tenant_id")
  admissionNo        String            @map("admission_no")
  admissionDate      DateTime          @map("admission_date") @db.Date
  name               String
  email              String
  avatar             String
  photoUrl           String?           @map("photo_url")
  bForm              String?           @map("b_form")
  dateOfBirth        DateTime          @map("date_of_birth") @db.Date
  gender             String
  bloodGroup         String?           @map("blood_group")
  religion           String?
  address            String
  previousSchool     String?           @map("previous_school")
  branchId           String            @map("branch_id")
  classId            String            @map("class_id")
  sectionId          String            @map("section_id")
  electiveSubjectIds String[]          @map("elective_subject_ids")
  siblingIds         String[]          @map("sibling_ids")
  monthlyFee         Int               @map("monthly_fee")
  discountPercent    Int               @map("discount_percent")
  enrollment         String
  withdrawal         Json?
  feeStatus          String            @default("clear") @map("fee_status")
  attendance         Int               @default(100)
  balance            Int               @default(0)
  guardians          Guardian[]
  documents          StudentDocument[]
  activity           StudentActivity[]

  @@unique([tenantId, bForm])
  @@map("student")
}

model Guardian {
  id         String  @id @default(cuid())
  tenantId   String  @map("tenant_id")
  studentId  String  @map("student_id")
  name       String
  relation   String
  cnic       String?
  phone      String
  whatsapp   Boolean
  primary    Boolean
  occupation String?
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("guardian")
}

model StudentDocument {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  studentId  String   @map("student_id")
  name       String
  kind       String
  fileName   String   @map("file_name")
  sizeKb     Int      @map("size_kb")
  uploadedAt DateTime @default(now()) @map("uploaded_at")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_document")
}

model StudentActivity {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  studentId String   @map("student_id")
  at        DateTime @default(now())
  actor     String
  text      String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_activity")
}

// ---------------------------------------------------------------------------
// Attendance (row-level security on tenant_id)
// ---------------------------------------------------------------------------

/// One class register: a section on a date (and a subject, in subject-wise mode). marks and changes
/// are kept as JSON, matching client/src/types/attendance.ts 1:1 (no per-mark table; see BACKEND-PLAN.md Phase 2 notes).
model AttendanceRegister {
  id             String          @id // "${sectionId}:${date}" or "${sectionId}:${date}:${subjectId}"
  tenantId       String          @map("tenant_id")
  branchId       String          @map("branch_id")
  classId        String          @map("class_id")
  sectionId      String          @map("section_id")
  date           DateTime        @db.Date
  subjectId      String?         @map("subject_id")
  /// Record<studentId, { status: "present"|"absent"|"leave", remark?: string }>
  marks          Json
  submittedAt    DateTime        @map("submitted_at")
  submittedBy    String          @map("submitted_by")
  lockedAt       DateTime?       @map("locked_at")
  lockedBy       String?         @map("locked_by")
  /// { at, by, reason } while a locked register is reopened for correction.
  reopened       Json?
  alertsSentAt   DateTime?       @map("alerts_sent_at")
  /// RegisterChange[]: marks changed after first submission.
  changes        Json            @default("[]")
  unlockRequests UnlockRequest[]

  @@map("attendance_register")
}

model UnlockRequest {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  registerId  String             @map("register_id")
  reason      String
  requestedBy String             @map("requested_by")
  requestedAt DateTime           @map("requested_at")
  /// "pending" | "approved" | "declined"
  status      String
  decidedBy   String?            @map("decided_by")
  decidedAt   DateTime?          @map("decided_at")
  register    AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@map("unlock_request")
}

model StaffAttendanceDay {
  id       String   @id // "${branchId}:${date}"
  tenantId String   @map("tenant_id")
  branchId String   @map("branch_id")
  date     DateTime @db.Date
  /// Record<staffId, "present"|"absent"|"leave"|"late">
  marks    Json
  savedAt  DateTime @map("saved_at")
  savedBy  String   @map("saved_by")

  @@map("staff_attendance_day")
}

// ---------------------------------------------------------------------------
// Fees (row-level security on tenant_id)
// ---------------------------------------------------------------------------

/// Client-supplied id (e.g. "tuition"); saveFeeHead upserts by id, matching the mock's contract.
model FeeHead {
  id           String   @id
  tenantId     String   @map("tenant_id")
  name         String
  /// "monthly" | "term" | "one_time"
  frequency    String
  /// Months a term head is charged, as "MM".
  termMonths   String[] @map("term_months")
  discountable Boolean

  @@map("fee_head")
}

/// Client-supplied id; saveFeePlan upserts by id.
model FeePlan {
  id       String @id
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")
  classId  String @map("class_id")
  /// Record<feeHeadId, amount>
  amounts  Json

  @@map("fee_plan")
}

/// Client-supplied id; saveConcession upserts by id.
model Concession {
  id       String @id
  tenantId String @map("tenant_id")
  name     String
  percent  Int

  @@map("concession")
}

model FeeVoucher {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  voucherNumber String    @map("voucher_number")
  studentId     String    @map("student_id")
  branchId      String    @map("branch_id")
  classId       String    @map("class_id")
  sectionId     String    @map("section_id")
  /// "YYYY-MM"
  month         String
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  /// VoucherLine[]
  lines         Json
  discount      Int
  totalAmount   Int       @map("total_amount")
  paidAmount    Int       @default(0) @map("paid_amount")
  /// "unpaid" | "partial" | "paid" | "cancelled"
  status        String    @default("unpaid")
  /// { at, by, reason }
  cancelled     Json?
  payments      Payment[]

  @@map("fee_voucher")
}

model Payment {
  id             String     @id @default(cuid())
  tenantId       String     @map("tenant_id")
  receiptNo      String     @map("receipt_no")
  voucherId      String     @map("voucher_id")
  studentId      String     @map("student_id")
  branchId       String     @map("branch_id")
  amount         Int
  lateFine       Int        @default(0) @map("late_fine")
  method         String
  at             DateTime
  by             String
  /// { at, by, reason }
  reversed       Json?
  /// Client-generated key so a retried request doesn't record the payment twice.
  idempotencyKey String?    @map("idempotency_key")
  voucher        FeeVoucher @relation(fields: [voucherId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@map("payment")
}

model DayClosing {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  branchId    String   @map("branch_id")
  date        DateTime @db.Date
  /// Record<PaymentMethod, number>
  totals      Json
  cashCounted Int      @map("cash_counted")
  note        String?
  closedAt    DateTime @map("closed_at")
  closedBy    String   @map("closed_by")

  @@unique([tenantId, branchId, date])
  @@map("day_closing")
}

model FeeReminder {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  studentId String   @map("student_id")
  at        DateTime
  by        String

  @@map("fee_reminder")
}

// ---------------------------------------------------------------------------
// Staff and payroll (row-level security on tenant_id)
// ---------------------------------------------------------------------------

model StaffMember {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  /// Employee number shown to people, e.g. "STF-201", via Counter.
  staffId       String   @map("staff_id")
  name          String
  avatar        String
  email         String
  phone         String
  /// Job title, e.g. "Senior Physics Lecturer".
  role          String
  department    String
  joinDate      DateTime @map("join_date") @db.Date
  /// "active" | "on_leave" | "terminated"
  status        String   @default("active")
  branchId      String   @map("branch_id")
  gender        String
  cnic          String?
  address       String?
  qualification String?
  /// "permanent" | "contract" | "visiting"
  employment    String
  /// Teaching staff appear in allocations and class incharge lists.
  teaches       Boolean
  basicSalary   Int      @map("basic_salary")
  /// SalaryComponent[]
  allowances    Json
  bankAccount   String?  @map("bank_account")
  /// { date, reason }
  left          Json?

  @@map("staff_member")
}

model TeacherAllocation {
  id            String @id @default(cuid())
  tenantId      String @map("tenant_id")
  /// Staff number, e.g. "STF-201".
  teacherId     String @map("teacher_id")
  subjectId     String @map("subject_id")
  classId       String @map("class_id")
  sectionId     String @map("section_id")
  weeklyPeriods Int    @map("weekly_periods")

  @@unique([tenantId, sectionId, subjectId])
  @@map("teacher_allocation")
}

model Advance {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  /// Staff number.
  staffId         String   @map("staff_id")
  amount          Int
  date            DateTime @db.Date
  reason          String
  /// Taken from each month's pay until repaid.
  monthlyRecovery Int      @map("monthly_recovery")
  recovered       Int      @default(0)

  @@map("advance")
}

model PayrollRun {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  branchId    String    @map("branch_id")
  /// "YYYY-MM"
  month       String
  /// "draft" | "finalised" | "paid"
  status      String    @default("draft")
  createdAt   DateTime  @map("created_at")
  createdBy   String    @map("created_by")
  finalisedAt DateTime? @map("finalised_at")
  payslips    Payslip[]

  @@unique([tenantId, branchId, month])
  @@map("payroll_run")
}

model Payslip {
  id              String     @id @default(cuid())
  tenantId        String     @map("tenant_id")
  runId           String     @map("run_id")
  /// Staff number.
  staffId         String     @map("staff_id")
  month           String
  basic           Int
  /// SalaryComponent[]
  allowances      Json
  /// One-off additions (positive) or deductions (negative) for the month.
  adjustments     Json
  absentDays      Int        @map("absent_days")
  absentDeduction Int        @map("absent_deduction")
  advanceRecovery Int        @map("advance_recovery")
  tax             Int
  eobi            Int
  gross           Int
  totalDeductions Int        @map("total_deductions")
  net             Int
  /// Teaching load from allocations, for reference.
  periodsPerWeek  Int        @map("periods_per_week")
  /// "draft" | "paid"
  status          String     @default("draft")
  paidAt          DateTime?  @map("paid_at")
  method          String?
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("payslip")
}

// Exams and results --------------------------------------------------------

model Exam {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  branchId    String      @map("branch_id")
  sessionId   String      @map("session_id")
  title       String
  /// "midterm" | "final" | "monthly" | "quiz"
  termType    String      @map("term_type")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  classIds    String[]    @map("class_ids")
  /// Set when results are published; marks are then locked.
  publishedAt DateTime?   @map("published_at")
  createdBy   String      @map("created_by")
  papers      ExamPaper[]
  marks       ExamMark[]

  @@unique([tenantId, branchId, title])
  @@map("exam")
}

model ExamPaper {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  examId     String @map("exam_id")
  classId    String @map("class_id")
  subjectId  String @map("subject_id")
  date       DateTime @db.Date
  totalMarks Int    @map("total_marks")
  passMarks  Int    @map("pass_marks")
  exam       Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examId, classId, subjectId])
  @@map("exam_paper")
}

model ExamMark {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  examId    String   @map("exam_id")
  subjectId String   @map("subject_id")
  studentId String   @map("student_id")
  /// Null while absent or not marked yet; half marks allowed.
  obtained  Float?
  absent    Boolean  @default(false)
  remark    String?
  updatedAt DateTime @map("updated_at")
  updatedBy String   @map("updated_by")
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examId, subjectId, studentId])
  @@map("exam_mark")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id")
  actorId    String?  @map("actor_id")
  actorName  String   @map("actor_name")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  data       Json?
  at         DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("audit_log")
}
